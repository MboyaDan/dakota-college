# Copy to .env for local development: cp .env.example .env
# Never commit .env. Values here are local-only and must never be used in
# staging or production.

# development | test | staging | production
APP_ENV=development
HTTP_ADDR=:8180
# debug | info | warn | error
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=15s
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For. Empty locally.
TRUSTED_PROXIES=

# Browser origins allowed to make state-changing requests (the frontend;
# 127.0.0.1:3100 is the Playwright test server).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3100
# Public frontend URL, used in links inside emails.
APP_BASE_URL=http://localhost:3000
# Sessions. Secure cookies need HTTPS, so local development over http turns it
# off. Staging and production refuse to start with false.
SESSION_COOKIE_SECURE=false
SESSION_TTL=12h
SESSION_IDLE_TIMEOUT=30m

# Outgoing email. Locally this is Mailpit (web UI http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.invalid

# Object storage (S3-compatible). Locally this is MinIO from docker compose;
# production uses Supabase Storage. Leave S3_ENDPOINT empty to disable uploads.
S3_ENDPOINT=localhost:9000
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=dakota_minio
S3_SECRET_KEY=dakota_minio_dev_only
S3_PUBLIC_BUCKET=dakota-public
S3_PRIVATE_BUCKET=dakota-private
# Where browsers load public images from.
S3_PUBLIC_BASE_URL=http://localhost:9000/dakota-public

# Virus scanning of applicant uploads (clamd host:port). Empty: uploads are
# stored as "not scanned". Locally: docker compose --profile scan up -d clamav,
# then CLAMAV_ADDR=localhost:3310.
CLAMAV_ADDR=

# M-Pesa C2B (Safaricom Daraja). Off unless MPESA_ENABLED=true. Every value
# comes from here: replace them with the college's own when it goes live.
MPESA_ENABLED=false
# sandbox | production (production is required when APP_ENV=production)
MPESA_ENV=sandbox
# Optional: the Daraja host. Defaults to the sandbox or production host.
# MPESA_API_BASE_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# The paybill (or till) number students pay to.
MPESA_SHORTCODE=
# What Safaricom does if our validation URL does not answer: Completed or Cancelled.
MPESA_C2B_RESPONSE_TYPE=Completed
# The API's public https address that Safaricom calls (no "mpesa" or
# "safaricom" in it: Safaricom refuses those).
MPESA_CALLBACK_BASE_URL=
# A long random secret that is part of the callback URL (openssl rand -hex 32).
MPESA_CALLBACK_SECRET=
# Optional: comma-separated IPs or CIDRs that callbacks must come from.
MPESA_ALLOWED_IPS=
# Optional: Daraja paths, if Safaricom changes the version.
# MPESA_REGISTER_URL_PATH=/mpesa/c2b/v2/registerurl
# MPESA_SIMULATE_PATH=/mpesa/c2b/v2/simulate

# First-run Super Admin (make setup-admin). Use only on an empty system, then
# remove the password from the environment.
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_PASSWORD=

# Used when running the API on your machine with `make run` (listens on
# HTTP_ADDR above). Inside Compose the api service overrides HTTP_ADDR and
# DATABASE_URL to use the "db" host.
DATABASE_URL=postgres://dakota:dakota_dev_only@localhost:5442/dakota?sslmode=disable
# Separate database for Go integration tests (created by docker/postgres/init).
TEST_DATABASE_URL=postgres://dakota:dakota_dev_only@localhost:5442/dakota_test?sslmode=disable

# Password for every test account the dev seed creates (make seed).
# Dev only, at least 12 characters. Never reuse it anywhere real.
SEED_PASSWORD=dakota-dev-only-password

# Compose services
POSTGRES_USER=dakota
POSTGRES_PASSWORD=dakota_dev_only
POSTGRES_DB=dakota
MINIO_ROOT_USER=dakota_minio
MINIO_ROOT_PASSWORD=dakota_minio_dev_only

# Host ports. Not the usual 8080/5432, so Dakota can run beside other projects.
API_PORT=8180
DB_PORT=5442
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
