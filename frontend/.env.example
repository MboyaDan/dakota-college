# Copy to .env.local for local development. Never commit .env.local.
# No secrets belong in the frontend: the browser never talks to the database
# or Supabase, only to /api/* on this origin.

# Go API origin that /api/* is rewritten to. Server-side only (not NEXT_PUBLIC).
# Default matches backend/.env.example API_PORT.
API_ORIGIN=http://localhost:8180

# Origin that uploaded content images are served from: the public bucket in
# the backend's S3_PUBLIC_BASE_URL, origin only. Allowed in the page
# Content-Security-Policy (D-191). Defaults to local MinIO.
CONTENT_IMAGE_ORIGIN=http://localhost:9000

# Visitor addresses for the API's rate limits (D-195). CLIENT_IP_HEADER names
# the header the hosting platform sets and overwrites with the visitor's
# address (for example cf-connecting-ip on Cloudflare); never a header a
# visitor can send through unchanged. CLIENT_IP_SECRET is the API's
# CLIENT_IP_SECRET: server-side only, never NEXT_PUBLIC_. Leave both empty
# locally. Set both in staging and production (Stage 19).
CLIENT_IP_HEADER=
CLIENT_IP_SECRET=

# Public site origin for absolute URLs in metadata (Open Graph and Twitter
# images). Origin only. Defaults to http://localhost:3000; set the real domain
# at deployment (Stage 19).
SITE_URL=http://localhost:3000

# Allow search engines to index the site. Leave unset (no indexing) for local,
# CI and staging; set to 1 only on the production launch (Stage 20).
SITE_INDEXABLE=
